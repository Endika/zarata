{
  "name": "zarata",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "description": "A sound level meter for your phone: watch the noise, set a limit, get a beep when it is crossed.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "type:check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,css,md,html}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,css,md,html}\"",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "terser": "^5.49.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
